// Phase 0 scaffolded the generator/datasource block only.
// M1 adds Organization/User + Role — see implementation-plan.md for what
// lands in later milestones (Channel/Contact/Conversation/Message at M2+).
//
// Prisma 7: the datasource block no longer carries a `url` — the connection
// string is supplied to PrismaClient via a driver adapter (see
// src/lib/prisma.ts) and to the CLI (migrate/studio/seed) via
// prisma.config.ts. See https://pris.ly/d/prisma7-client-config.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// --- M1: tenancy and identity ------------------------------------------

model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  users     User[]
  channels  Channel[]
  contacts  Contact[]
  templates Template[]
}

model User {
  id             String    @id @default(cuid())
  organizationId String
  email          String
  passwordHash   String
  name           String
  role           Role      @default(AGENT)
  isOnline       Boolean   @default(false)
  lastSeenAt     DateTime?
  createdAt      DateTime  @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, email])
  @@index([organizationId])
}

enum Role {
  ADMIN // full access, manages channels, templates, users
  AGENT // sees assigned + unassigned conversations, sends messages
}

// --- M2: provider adapter + ingestion (Phase A / Baileys) ---------------
// Channel/Contact/Conversation/Message match context.md §7.2-7.4 and
// architecture.md verbatim. Back-reference array/optional fields not shown
// in those sections (e.g. Organization.channels above, Channel.conversations
// below) are added only where Prisma's relation validation requires them for
// a `@relation` declared on the other side — no relation exists for
// Conversation/Message's organizationId, or for Conversation.assignedUserId
// / Message.sentByUserId, matching context.md exactly (those stay plain
// scalars, not enforced foreign keys).

model Channel {
  id                String        @id @default(cuid())
  organizationId    String
  displayName       String
  phoneNumber       String
  provider          String        @default("baileys")
  metaPhoneNumberId String?       @unique
  metaWabaId        String?
  sessionRef        String?
  accessTokenRef    String?
  qualityRating     String?
  messagingTier     String?
  status            ChannelStatus @default(ACTIVE)
  createdAt         DateTime      @default(now())

  organization      Organization  @relation(fields: [organizationId], references: [id])
  conversations     Conversation[]
  templates         Template[]

  // Baileys session storage (src/providers/baileys/session-store.ts) —
  // present regardless of `provider`, simply unused when provider is
  // "cloud-api". See BaileysSessionData/BaileysSignalKey below for why this
  // is two tables rather than one JSON blob on Channel itself.
  baileysSession    BaileysSessionData?
  baileysSignalKeys BaileysSignalKey[]

  @@index([organizationId])
}

enum ChannelStatus {
  ACTIVE
  DISCONNECTED
  SUSPENDED
}

model Contact {
  id             String   @id @default(cuid())
  organizationId String
  waId           String
  name           String?
  displayName    String?
  customFields   Json     @default("{}")
  isBlocked      Boolean  @default(false)
  createdAt      DateTime @default(now())

  organization   Organization   @relation(fields: [organizationId], references: [id])
  conversations  Conversation[]

  @@unique([organizationId, waId])
  @@index([organizationId])
}

model Conversation {
  id             String    @id @default(cuid())
  organizationId String
  channelId      String
  contactId      String
  assignedUserId String?
  status         ConversationStatus @default(OPEN)
  lastMessageAt  DateTime?
  lastInboundAt  DateTime?
  unreadCount    Int       @default(0)
  createdAt      DateTime  @default(now())

  channel        Channel   @relation(fields: [channelId], references: [id])
  contact        Contact   @relation(fields: [contactId], references: [id])
  messages       Message[]

  @@unique([channelId, contactId])
  @@index([organizationId, status, lastMessageAt])
  @@index([assignedUserId])
}

enum ConversationStatus {
  OPEN
  DONE
}

model Message {
  id                 String   @id @default(cuid())
  organizationId     String
  conversationId     String
  provider           String
  providerMessageId  String?  @unique
  direction          Direction
  type               MessageType
  body               String?
  mediaId            String?
  templateName       String?
  templatePayload    Json?
  interactivePayload Json?
  // Deliberate addition beyond context.md §7.4's literal column list: the
  // milestone's own acceptance test requires proving an UNSUPPORTED-typed
  // inbound message stores its original payload ("raw preserved"), and
  // NormalizedInboundEvent.raw ("always preserve the original payload",
  // src/providers/types.ts) has to land somewhere durable to mean that.
  // Flagged in TODO-VERIFY.md rather than silently added.
  rawPayload         Json?
  status             MessageStatus @default(PENDING)
  errorCode          String?
  errorMessage       String?
  sentByUserId       String?
  metaTimestamp      DateTime
  createdAt          DateTime @default(now())

  conversation       Conversation @relation(fields: [conversationId], references: [id])

  @@index([conversationId, metaTimestamp])
  @@index([organizationId])
}

enum Direction {
  INBOUND
  OUTBOUND
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  STICKER
  LOCATION
  CONTACTS
  INTERACTIVE
  TEMPLATE
  BUTTON
  REACTION
  UNSUPPORTED
}

enum MessageStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

// --- M2: Baileys session credential storage ------------------------------
// Baileys' own `useMultiFileAuthState` helper persists to local disk, which
// (a) does not survive a redeploy and (b) is explicitly disallowed here
// (context.md §8.1b: "Session credentials persist to the database or object
// storage... not to local disk"). These two tables are the from-scratch
// AuthenticationState backing store used by
// src/providers/baileys/session-store.ts. `Channel.sessionRef` holds this
// row's id as the documented "pointer to stored Baileys session state"
// (context.md §7.2).
//
// Split into two tables rather than one JSON blob because they change at
// very different rates: `creds` is one small object updated occasionally
// (on `creds.update`); signal protocol key material (pre-keys, sessions,
// sender keys, app-state sync keys, ...) is many small, independently
// keyed entries read/written constantly during normal operation — cramming
// both into a single ever-growing JSON column would mean a read-modify-
// write of the whole blob for every single key touched.
model BaileysSessionData {
  id        String   @id @default(cuid())
  channelId String   @unique
  creds     Json?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  channel   Channel  @relation(fields: [channelId], references: [id])
}

model BaileysSignalKey {
  id        String   @id @default(cuid())
  channelId String
  // SignalDataTypeMap key from @whiskeysockets/baileys, e.g. "pre-key",
  // "session", "sender-key", "app-state-sync-key", "app-state-sync-version".
  category  String
  keyId     String
  value     Json
  updatedAt DateTime @updatedAt

  channel   Channel  @relation(fields: [channelId], references: [id])

  @@unique([channelId, category, keyId])
  @@index([channelId, category])
}

// --- M6: media ------------------------------------------------------------
// Matches context.md §7.5 exactly. No Prisma relation to Message: Message.
// mediaId is resolved through src/data/media.ts's own organizationId-scoped
// lookups (src/data/media.ts's attachMediaSummary/attachMediaSummaries),
// never a Prisma `include` — same precedent this file's M2 comment already
// set for Conversation.assignedUserId / Message.sentByUserId ("stay plain
// scalars, not enforced foreign keys").
model Media {
  id             String   @id @default(cuid())
  organizationId String
  storageKey     String
  mimeType       String
  fileName       String?
  sizeBytes      Int?
  metaMediaId    String?
  createdAt      DateTime @default(now())

  @@index([organizationId])
}

// --- M7: templates --------------------------------------------------------
model Template {
  id              String   @id @default(cuid())
  organizationId  String
  channelId       String
  metaTemplateId  String?
  name            String
  language        String
  category        String
  status          String
  components      Json
  rejectionReason String?
  lastSyncedAt    DateTime?

  channel         Channel  @relation(fields: [channelId], references: [id])
  organization    Organization @relation(fields: [organizationId], references: [id])

  @@unique([channelId, name, language])
  @@index([organizationId])
}

// --- M8: CRM Layer --------------------------------------------------------
model Tag {
  id             String @id @default(cuid())
  organizationId String
  name           String
  color          String?

  @@unique([organizationId, name])
}

model ContactTag {
  contactId String
  tagId     String
  @@id([contactId, tagId])
}

model Note {
  id             String   @id @default(cuid())
  organizationId String
  contactId      String
  authorUserId   String
  body           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([contactId])
}

model CustomFieldDefinition {
  id             String @id @default(cuid())
  organizationId String
  key            String
  label          String
  type           FieldType
  options        Json?    // for LIST type

  @@unique([organizationId, key])
}

enum FieldType {
  TEXT
  NUMBER
  DATE
  LIST
}

model QuickReply {
  id             String  @id @default(cuid())
  organizationId String
  shortcut       String
  body           String
  mediaId        String?

  @@unique([organizationId, shortcut])
}

// --- M10: Meta webhook receiver --------------------------------------------
// context.md §7.5: "stores every raw payload before processing. When
// something inexplicable happens in production ... this table is how you
// find out what Meta actually sent. Retain 30 days." Referenced by
// src/app/api/webhooks/meta/route.ts — added here because that route
// already called prisma.webhookEvent.* against a model that didn't exist
// yet (found during the post-hoc fix/verify pass on 2026-08-22, see
// parallel-work-inventory.md).
model WebhookEvent {
  id          String    @id @default(cuid())
  rawPayload  Json
  signature   String
  processedAt DateTime?
  error       String?
  receivedAt  DateTime  @default(now())
}
