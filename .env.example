# Copy to .env and fill in real values. Never commit .env with real secrets.
#
# Every value below is a SHAPE EXAMPLE, not a working credential — they show
# the format each variable expects. src/config/env.ts validates all of them at
# import time and throws on anything missing or malformed, so a typo here
# fails at boot rather than at the first request that needs the value.

# WhatsApp provider adapter to use — see src/providers (Milestone M2).
# One of: baileys | cloud-api
WHATSAPP_PROVIDER=baileys

# PostgreSQL connection string (Prisma).
DATABASE_URL=postgresql://user:pass@localhost:5432/dbname

# Redis connection string (BullMQ).
REDIS_URL=redis://localhost:6379

# Secret used to sign/encrypt session data. Minimum 32 characters.
# Generate a real one, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-random-string-of-at-least-32-chars

# MinIO / S3-compatible object storage.
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=chowk
OBJECT_STORAGE_ACCESS_KEY=replace-with-access-key
OBJECT_STORAGE_SECRET_KEY=replace-with-secret-key
OBJECT_STORAGE_REGION=us-east-1
# MinIO requires path-style addressing (unlike AWS S3 proper).
OBJECT_STORAGE_FORCE_PATH_STYLE=true

# Meta Cloud API credentials (Phase B / M10 only — all optional, and unused
# while WHATSAPP_PROVIDER=baileys).
# META_APP_SECRET=your-meta-app-secret
# META_VERIFY_TOKEN=a-string-you-choose-and-give-to-meta
# META_ACCESS_TOKEN=your-meta-graph-api-access-token
